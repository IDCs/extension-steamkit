{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "steamkit",
  "version": "0.2.2",
  "description": "This Vortex extension interacts with the Steam Depot Downloader application, allowing game extensions to execute certain SteamAPI functionalities",
  "main": "./dist/index.js",
  "type": "commonjs",
  "author": "Nagev",
  "license": "GPL-2.0",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "assets": "copyfiles -f icons.svg dist && copyfiles -f ./*.scss dist && copyfiles -f ./*.jpg dist",
    "build": "node build.mjs && pnpm run assets && pnpm exec extractInfo",
    "bundle7z": "7z a -t7z steamkit.7z ./dist/icons.svg ./dist/index.js ./dist/info.json ./dist/steam.jpg ./dist/workshop.scss",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "node-rest-client": "^3.1.1"
  },
  "devDependencies": {
    "7z-bin": "github:Nexus-Mods/7z-bin#3298c42e69e3220dc39694bc2f610c077c3e213a",
    "@nexusmods/vortex-api": "^2.7.2",
    "@types/bluebird": "3.5.20",
    "@types/lodash": "4.17.24",
    "@types/minimatch": "2.0.29",
    "@types/node": "24.12.2",
    "@types/react": "^18.3.0",
    "@types/react-bootstrap": "0.32.37",
    "@types/react-redux": "7.1.34",
    "@types/react-select": "1.3.6",
    "@types/shortid": "2.2.0",
    "bluebird": "3.7.2",
    "copyfiles": "2.4.1",
    "i18next": "21.10.0",
    "lodash": "4.17.23",
    "minimatch": "3.1.5",
    "react": "18.3.1",
    "react-bootstrap": "0.33.1",
    "react-i18next": "11.18.6",
    "react-redux": "7.2.9",
    "react-select": "1.3.0",
    "redux-act": "1.8.0",
    "rolldown": "1.1.4",
    "shortid": "2.2.17",
    "typescript": "6.0.3"
  }
}
