{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "steamkit",
  "version": "1.0.1",
  "description": "This Vortex extension interacts with the Steam Depot Downloader application, allowing game extensions to execute certain SteamAPI functionalities",
  "main": "./dist/index.js",
  "type": "commonjs",
  "author": "Nagev",
  "license": "GPL-2.0",
  "packageManager": "pnpm@11.10.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "assets": "copyfiles -f icons.svg dist && copyfiles -f ./*.jpg dist",
    "build": "pnpm run build:dotnet && pnpm run build:js",
    "build:dotnet": "dotnet publish DepotDownloaderNative/DepotDownloaderNative.csproj -c Release -p:DebugType=none -o dist/dotnet",
    "build:js": "node build.mjs && pnpm run assets && pnpm exec extractInfo",
    "bundle7z": "7z a -t7z steamkit.7z ./dist/* -xr!*.map",
    "catalog:update": "node scripts/catalog/run.mjs",
    "test": "pnpm run test:dotnet && pnpm run test:js",
    "test:dotnet": "dotnet test DepotDownloaderNative.Tests/DepotDownloaderNative.Tests.csproj",
    "test:js": "vitest run",
    "test:steam": "pnpm run test:steam:dotnet && pnpm run test:steam:js",
    "test:steam:dotnet": "dotnet test DepotDownloaderNative.SteamTests/DepotDownloaderNative.SteamTests.csproj",
    "test:steam:js": "vitest run --config vitest.steam.config.mts",
    "typedefs": "pnpm run build:dotnet && node typedefs.mjs",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "7z-bin": "github:Nexus-Mods/7z-bin#3298c42e69e3220dc39694bc2f610c077c3e213a",
    "@nexusmods/vortex-api": "^2.7.2",
    "@types/bluebird": "3.5.20",
    "@types/node": "24.12.2",
    "@types/react": "^18.3.0",
    "@types/react-bootstrap": "0.32.37",
    "@types/react-redux": "7.1.34",
    "@types/react-select": "1.3.6",
    "copyfiles": "2.4.1",
    "i18next": "21.10.0",
    "node-api-dotnet": "^0.9.27",
    "node-api-dotnet-generator": "0.9.27",
    "react": "18.3.1",
    "react-bootstrap": "0.33.1",
    "react-i18next": "11.18.6",
    "react-redux": "7.2.9",
    "redux-act": "1.8.0",
    "rolldown": "1.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "zone.js": "0.15.1"
  }
}
