{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "pnpm run build",
			"problemMatcher": [
				"$tsc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "pnpm: build"
		},
		{
			"type": "shell",
			"command": "pnpm run typecheck",
			"problemMatcher": [
				"$tsc"
			],
			"group": "test",
			"label": "pnpm: typecheck"
		}
	]
}
